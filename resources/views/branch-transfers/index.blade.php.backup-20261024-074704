            'st' => $pend ? 'Pending' : ($o->status === 'complete' ? ($o->sent_qty > 0 ? 'Sent' : 'Closed') : 'Cancelled'),
            'ord' => (int) $o->ordered_qty, 'sent' => (int) $o->sent_qty, 'bal' => (int) $o->balance_qty,
            'note' => $o->notes, 'why' => $o->short_reason, 'closed' => (int) $o->items->sum('qty_closed'),
            'rev' => round($del->sum($batchRev), 2),
