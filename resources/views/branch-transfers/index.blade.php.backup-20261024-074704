    if(pend && o.sent > 0) h += '<p><b>Short ' + o.bal + '</b> will be delivered in the next batch.</p>';
    if(o.closed > 0) h += '<p><b>Closed short ' + o.closed + ':</b> ' + esc(o.why) + '</p>';
    if(o.note) h += '<p class="muted">Note: ' + esc(o.note) + '</p>';
    if(o.dl.length) h += '<h4 style="font-size:14px;margin:16px 0 0">Deliveries</h4><table><thead><tr><th class="l">Date</th><th class="l">Items</th><th>Pcs</th><th>Amount</th></tr></thead><tbody>'
