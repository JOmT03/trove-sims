function printOrder(id){
    const o = SLIPS.find(x => x.id == id); if(!o) return;
    const pend = o.st === 'Pending';
    let h = '<div id="slipArea" class="slip"><h4>Order #' + o.id + ' \u00b7 Jacinto Branch</h4><div class="muted">From Matina Commissary \u00b7 printed ' + TODAY_LBL + '</div>'
        + '<div class="mt"><span>Needed by: <b>' + esc(o.need) + '</b></span><span>Status: <b>' + o.st + '</b></span>' + (pend ? '<span class="bpb">' + o.bal + ' pcs not yet sent</span>' : '') + '</div>'
        + '<table><thead><tr><th class="l">Product</th><th>Ordered</th><th>Sent</th><th>Not yet sent</th></tr></thead><tbody>'
        + o.items.map(i => '<tr><td class="l">' + esc(i.n) + '</td><td>' + i.q + '</td><td>' + i.d + '</td><td><b>' + i.bl + '</b></td></tr>').join('')
